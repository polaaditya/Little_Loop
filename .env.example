# ─── LittleLoop environment variables ────────────────────────────────────
# Copy this file to .env and edit it.
#   cp .env.example .env

# ─── Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # set to "production" in AWS

# ─── Database ─────────────────────────────────────────────────────────────
# Leave DATABASE_URL blank → SQLite is used automatically (great for local dev).
# Set DATABASE_URL to your PostgreSQL connection string for staging or production.
#
# Local PostgreSQL (Docker):
#   DATABASE_URL=postgresql://littleloop:littleloop@localhost:5432/littleloop
#
# AWS RDS PostgreSQL:
#   DATABASE_URL=postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/littleloop
#
DATABASE_URL=

# SQLite file path (used only when DATABASE_URL is blank)
SQLITE_PATH=./data/littleloop.db
